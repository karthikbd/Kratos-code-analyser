[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pydantic         = ">=2.6"
rich             = ">=13.7"
typer            = ">=0.12"
networkx         = ">=3.3"
python-dateutil  = ">=2.9"
langchain        = ">=0.2"
langchain-openai = ">=0.1"
langchain-community = ">=0.2"
langchain-core   = ">=0.2"
langgraph        = ">=0.1"
openai           = ">=1.30"
faiss-cpu        = "*"
tiktoken         = "*"
httpx            = ">=0.27"
pandas           = ">=2.2"
fastapi          = ">=0.110"
uvicorn          = {version = ">=0.29", extras = ["standard"]}
websockets       = ">=12"
python-dotenv    = "*"
langchain-text-splitters = "*"

[dev-packages]
pytest           = ">=8"
pytest-cov       = "*"
mypy             = "*"

[requires]
python_version = "3.11"

[scripts]
analyze     = "python -m backend.cli analyze"
scan        = "python -m backend.cli scan"
certify     = "python -m backend.cli certify"
pipeline    = "python -m backend.cli full-pipeline"
report      = "python -m backend.cli report"
benchmark   = "python -m backend.cli benchmark"
server      = "uvicorn backend.server:app --reload --host 0.0.0.0 --port 8001"
